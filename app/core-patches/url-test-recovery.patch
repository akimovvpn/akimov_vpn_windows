+package outboundgroup
+
+import (
+	"fmt"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type recoveryProxy struct {
+	C.Proxy
+	name  string
+	alive bool
+}
+
+func (p *recoveryProxy) Name() string                { return p.name }
+func (p *recoveryProxy) AliveForTestUrl(string) bool { return p.alive }
+func (p *recoveryProxy) LastDelayForTestUrl(string) uint16 {
+	if p.alive {
+		return 42
+	}
+	return 0xffff
+}
+
+func TestURLTestRecoversCachedDeadMember(t *testing.T) {
+	for live := 0; live < 4; live++ {
+		t.Run(fmt.Sprint(live), func(t *testing.T) {
+			members := make([]C.Proxy, 4)
+			for i := range members {
+				members[i] = &recoveryProxy{name: fmt.Sprintf("Estonia LTE %d", i+1)}
+			}
+			group, err := NewURLTest(GroupCommonOption{Name: "Estonia LTE auto", URL: "https://speed.cloudflare.com/__down?bytes=50000"}, URLTestOption{Tolerance: 150}, members[0], nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			group.providerProxies = members
+			group.Now() // Cache a dead choice before the health checks finish.
+			members[live].(*recoveryProxy).alive = true
+			if got := group.Now(); got != members[live].Name() {
+				t.Fatalf("one of four members works; selected %q instead of %q", got, members[live].Name())
+			}
+			members[live].(*recoveryProxy).alive = false
+			group.Now() // All dead must still return without recursion looping.
+		})
+	}
+}
