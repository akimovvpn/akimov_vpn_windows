diff --git a/adapter/outbound/reality_akimov_test.go b/adapter/outbound/reality_akimov_test.go
new file mode 100644
--- /dev/null
+++ b/adapter/outbound/reality_akimov_test.go
@@ -0,0 +1,30 @@
+package outbound
+
+import (
+	"encoding/base64"
+	"testing"
+)
+
+func TestRealityClientVersions(t *testing.T) {
+	key := base64.RawURLEncoding.EncodeToString(make([]byte, 32))
+	modern, err := (RealityOptions{PublicKey: key}).Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if modern.ClientVersion != [3]byte{26, 3, 27} || !modern.SupportX25519MLKEM768 {
+		t.Fatal("modern defaults missing")
+	}
+	legacy := false
+	old, err := (RealityOptions{PublicKey: key, SupportX25519MLKEM768: &legacy}).Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if old.ClientVersion != [3]byte{1, 8, 2} || old.SupportX25519MLKEM768 {
+		t.Fatal("legacy opt-out lost")
+	}
+	for _, version := range []string{"26.3", "26.256.1", "-1.3.27", "26.3.27.1"} {
+		if _, err := (RealityOptions{PublicKey: key, ClientVersion: version}).Parse(); err == nil {
+			t.Fatalf("accepted invalid version %s", version)
+		}
+	}
+}
diff --git a/component/tls/reality_akimov_test.go b/component/tls/reality_akimov_test.go
new file mode 100644
--- /dev/null
+++ b/component/tls/reality_akimov_test.go
@@ -0,0 +1,31 @@
+package tls
+
+import (
+	utls "github.com/metacubex/utls"
+	"testing"
+)
+
+func TestModernRealityHelloAndLegacyOptOut(t *testing.T) {
+	for _, hybrid := range []bool{true, false} {
+		client, err := buildRealityClient(nil, &utls.Config{ServerName: "localhost"}, utls.HelloFirefox_120, hybrid)
+		if err != nil {
+			t.Fatal(err)
+		}
+		found := false
+		classical := false
+		for _, share := range client.HandshakeState.Hello.KeyShares {
+			if share.Group == utls.X25519 {
+				classical = true
+			}
+			if share.Group == utls.X25519MLKEM768 {
+				if classical {
+					t.Fatal("hybrid share must precede classical share")
+				}
+				found = true
+			}
+		}
+		if found != hybrid {
+			t.Fatalf("hybrid=%v, found=%v", hybrid, found)
+		}
+	}
+}
