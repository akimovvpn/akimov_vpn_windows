+
+// Modern REALITY servers require a hybrid key share that legacy fingerprints cannot provide.
+func buildRealityClient(conn net.Conn, config *utls.Config, fingerprint UClientHelloID, hybrid bool) (*utls.UConn, error) {
+	client := utls.UClient(conn, config, fingerprint)
+	if err := client.BuildHandshakeState(); err != nil {
+		return nil, err
+	}
+	hasHybrid := false
+	for _, share := range client.HandshakeState.Hello.KeyShares {
+		if share.Group == utls.X25519MLKEM768 {
+			hasHybrid = true
+		}
+	}
+	if hybrid && !hasHybrid {
+		client = utls.UClient(conn, config, utls.HelloChrome_Auto)
+		if err := client.BuildHandshakeState(); err != nil {
+			return nil, err
+		}
+	}
+	if !hybrid {
+		if err := BuildRemovedX25519MLKEM768HandshakeState(client); err != nil {
+			return nil, err
+		}
+	}
+	return client, nil
+}
