+package adapter
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/utils"
+	"github.com/metacubex/mihomo/component/ca"
+)
+
+func TestURLTestUnifiedKeepAlive(t *testing.T) {
+	previous := UnifiedDelay.Load()
+	UnifiedDelay.Store(true)
+	defer UnifiedDelay.Store(previous)
+	defer ca.ResetCertificate()
+	expected, _ := utils.NewUnsignedRanges[uint16]("204")
+	for _, closeConnection := range []bool{false, true} {
+		var requests, connections atomic.Int32
+		server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if requests.Add(1) == 1 {
+				time.Sleep(200 * time.Millisecond)
+			}
+			if closeConnection {
+				w.Header().Set("Connection", "close")
+			}
+			w.WriteHeader(http.StatusNoContent)
+		}))
+		server.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+			if state == http.StateNew {
+				connections.Add(1)
+			}
+		}
+		server.StartTLS()
+		if err := ca.AddCertificate(string(server.Certificate().Raw)); err != nil {
+			t.Fatal(err)
+		}
+		proxy := NewProxy(outbound.NewDirect())
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		delay, err := proxy.URLTest(ctx, server.URL, expected)
+		cancel()
+		server.Close()
+		if closeConnection {
+			if err == nil || delay != 0 {
+				t.Fatalf("failed keep-alive must not report cold latency: delay=%d error=%v", delay, err)
+			}
+		} else if err != nil || delay == 0 || delay >= 150 || requests.Load() != 2 || connections.Load() != 1 {
+			t.Fatalf("must time the warm request on one TLS connection: delay=%d requests=%d connections=%d error=%v", delay, requests.Load(), connections.Load(), err)
+		}
+	}
+}
